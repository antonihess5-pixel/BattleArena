{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build BattleArena",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "src/main.cpp",
                "src/Game.cpp",
                "src/PlayerBase.cpp",
                "src/Warrior.cpp",
                "src/Mage.cpp",
                "src/Projectile.cpp",
                "-IC:/BattleArena/SFML/include",
                "-LC:/BattleArena/SFML/lib",
                "-LC:/SFML-src/extlibs/libs-mingw/x64",
                "-lsfml-graphics-s",
                "-lsfml-window-s",
                "-lsfml-system-s",
                "-lopengl32",
                "-lfreetype",
                "-lopenal32",
                "-lwinmm",
                "-lgdi32",
                "-DSFML_STATIC",
                "-o",
                "BattleArena.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}